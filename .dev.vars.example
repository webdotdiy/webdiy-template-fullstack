# Copy this file to `.dev.vars` and fill in your Supabase project values.
# `.dev.vars` is gitignored — never commit real keys.
#
# Get these from your Supabase project at https://supabase.com/dashboard
# under Project Settings → API.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Vite reads VITE_-prefixed vars at build time and inlines them into
# the browser bundle. The two below are duplicates of SUPABASE_URL +
# SUPABASE_ANON_KEY exposed to the browser-side Supabase client. Never
# expose SUPABASE_SERVICE_ROLE_KEY here — it bypasses RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Neon Auth + Data API (optional) --------------------------------------
# On WebDIY these are provisioned automatically when the project enables the
# database integration: the VITE_NEON_* public values are managed in `.env`,
# and NEON_AUTH_SERVER_KEY is delivered as a secret binding — nothing to set
# here. For standalone use outside WebDIY: put the VITE_NEON_* values in
# `.env` (they are public endpoint URLs) and the server key below.
#
# NEON_AUTH_SERVER_KEY=your-neon-auth-secret-server-key
